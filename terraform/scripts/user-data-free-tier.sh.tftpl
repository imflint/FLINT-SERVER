#!/bin/bash
set -euo pipefail

APP_NAME="${app_name}"
DOMAIN_NAME="${domain_name}"
ENVIRONMENT="${environment}"
PARAMETER_PREFIX="${parameter_prefix}"
REDIS_CONTAINER_NAME="${redis_container_name}"
# Keep the existing GitHub Actions and scripts/deploy.sh path contract.
APP_DIR="/home/ubuntu"

echo "=== Flint free-tier EC2 setup ($APP_NAME / $ENVIRONMENT) ==="

dnf update -y
dnf install -y java-21-amazon-corretto-headless nginx docker awscli curl lsof
dnf install -y certbot python3-certbot-nginx || echo "WARN: certbot packages were not installed during user-data; deploy.sh will retry."

systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

mkdir -p "$APP_DIR/deploy" "$APP_DIR/logs"
chown -R ec2-user:ec2-user "$APP_DIR"
touch "$APP_DIR/logs/deploy.log"
chown ec2-user:ec2-user "$APP_DIR/logs/deploy.log"
mkdir -p /var/log/nginx
mkdir -p /var/www/certbot
touch /var/log/nginx/error.log /var/log/nginx/flint-gateway-error.log

cat >/etc/nginx/conf.d/flint-upstream.conf <<'EOF'
upstream flint-api {
    server 127.0.0.1:8080;
}
EOF

cat >/etc/nginx/conf.d/00-flint-gateway-error-log.conf <<'EOF'
map $status $flint_log_gateway_error {
    502 1;
    503 1;
    504 1;
    default 0;
}

log_format flint_gateway_error 'FLINT_GATEWAY_ERROR $remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';
access_log /var/log/nginx/flint-gateway-error.log flint_gateway_error if=$flint_log_gateway_error;
EOF

cat >/etc/nginx/conf.d/flint-api.conf <<'EOF'
server {
    listen 80;
    server_name ${domain_name};

    client_max_body_size 20m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://flint-api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
EOF

nginx -t
systemctl enable nginx
systemctl restart nginx

docker volume create flint-redis-data >/dev/null
if ! docker ps -a --format '{{.Names}}' | grep -qx "$REDIS_CONTAINER_NAME"; then
  docker run -d \
    --name "$REDIS_CONTAINER_NAME" \
    --restart unless-stopped \
    -p 127.0.0.1:6379:6379 \
    -v flint-redis-data:/data \
    redis:7-alpine \
    redis-server --appendonly yes
else
  docker start "$REDIS_CONTAINER_NAME" || true
fi

cat >"$APP_DIR/README-DEPLOY.txt" <<EOF
Flint free-tier host initialized.

App dir: $APP_DIR
Spring profile expected by current scripts/deploy.sh: dev
Parameter Store prefix: $PARAMETER_PREFIX
Redis: localhost:6379 via Docker container $REDIS_CONTAINER_NAME
Domain: $DOMAIN_NAME
Nginx: 80 -> flint-api upstream -> active app port

Upload the JAR and run scripts/deploy.sh, or trigger deployment through SSM.
EOF

chown -R ec2-user:ec2-user "$APP_DIR"

echo "=== Flint free-tier EC2 setup complete ==="
